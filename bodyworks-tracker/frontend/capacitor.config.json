{
  "appId": "com.bodyworksgym.tracker",
  "appName": "BW Tracker",
  "webDir": "dist",
  "backgroundColor": "#000000",
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "disable"
    },
    "SplashScreen": {
      "launchShowDuration": 8000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 180,
      "backgroundColor": "#000000",
      "showSpinner": false
    }
  }
}
